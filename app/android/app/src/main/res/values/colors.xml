<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        lili's own colours for the Android system bars. Before these existed the
        theme pointed at colorPrimary / colorPrimaryDark, which lili never
        defined, so Android fell back to the template library's blue (#303F9F)
        and the phone's status and navigation bars were blue above and below a
        cream app. They now match the page ground, the c-bg colour in theme/palette.css.
    -->
    <color name="colorPrimary">#FFF8F2</color>
    <color name="colorPrimaryDark">#FFF8F2</color>
    <color name="colorAccent">#A0614A</color>
    <color name="lili_system_bar">#FFF8F2</color>
    <bool name="lili_light_bars">true</bool>
</resources>
