<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Both languages the app serves. Without this iOS reports the app as
	     English-only in Settings → lili → Language, and an Arabic-first phone
	     never offers the switch — the one the app has had since v2.9.3. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>love it or leave it</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Was armv7. That is the 32-bit instruction set: the last 32-bit iPhone
	     was the 5c, and iOS has not run 32-bit apps since iOS 11. Declaring it
	     as a REQUIRED capability asks the App Store for devices that no longer
	     exist, and is the kind of template leftover that surfaces as an
	     unexplained "no compatible devices" at submission. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only, on both. Every screen in this app is built for a single
	     narrow column with a fixed bottom bar; there is no landscape layout and
	     never was one. Declaring landscape support means a reviewer rotates the
	     phone, sees a stretched feed with the navigation halfway up the screen,
	     and is right to reject it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Answered here so it is not answered by hand, differently, on every
	     upload. The app uses HTTPS and the platform's own crypto and nothing
	     else — which is exactly the exemption this key declares. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.loveitorleaveit.lili</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.loveitorleaveit.lili</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>lili uses your camera to photograph the pieces you list.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>lili needs your photo library so you can add pictures to a listing.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>lili saves listing photos you choose to keep.</string>
</dict>
</plist>
